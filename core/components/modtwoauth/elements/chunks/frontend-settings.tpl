<div class="m2af-card" id="m2af-settings" data-api="[[+api]]" data-register="[[+register]]" data-csrf="[[+csrf]]" data-provider="[[+provider]]">
<style>
.m2af-card{max-width:760px;padding:24px;border:1px solid #d9dee5;border-radius:12px;background:#fff;color:#20252b;font:16px/1.5 system-ui,-apple-system,sans-serif}.m2af-card h2{margin:0 0 8px;font-size:1.5rem}.m2af-muted{color:#626d78}.m2af-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:16px 0}.m2af-card button,.m2af-card select,.m2af-card input{font:inherit;padding:10px 12px;border:1px solid #b8c1cb;border-radius:7px}.m2af-card button{cursor:pointer;background:#1459a6;color:#fff;border-color:#1459a6}.m2af-card button.secondary{background:#fff;color:#20252b;border-color:#b8c1cb}.m2af-card button.danger{background:#a52828;border-color:#a52828}.m2af-card input{max-width:100%;box-sizing:border-box}.m2af-status{padding:12px;border-radius:7px;background:#f0f4f8;margin:14px 0}.m2af-message{margin:12px 0;padding:10px;border-radius:7px;display:none}.m2af-message.error{display:block;background:#ffeded;color:#9c2020}.m2af-message.ok{display:block;background:#e9f8ee;color:#176b35}.m2af-setup{margin-top:16px;padding:16px;border:1px solid #d9dee5;border-radius:8px;display:none}.m2af-setup img{width:220px;height:220px;object-fit:contain}.m2af-card label{display:block;margin:10px 0 5px}.m2af-card .wide{width:100%;max-width:360px}.m2af-small{font-size:.9rem}.m2af-session{border:1px solid #d9dee5;border-radius:8px;padding:12px;margin:10px 0;overflow-wrap:anywhere}.m2af-session strong{display:block;margin-bottom:4px}.m2af-session-meta{font-size:.9rem;color:#626d78;margin:3px 0}.m2af-session button{margin-top:8px}.m2af-session-current{display:inline-block;background:#e9f8ee;color:#176b35;border-radius:4px;padding:2px 7px;font-size:.8rem}
</style>
<h2>[[+title]]</h2>
<p class="m2af-muted">[[+intro]]</p>
<div class="m2af-status"><strong>[[+current_label]]</strong> <span id="m2af-current">[[+current]]</span><br><strong>[[+state_label]]</strong> <span id="m2af-state">[[+state]]</span>[[+verify_note]]</div>
<div class="m2af-row"><label for="m2af-provider">[[+method_label]]</label><select id="m2af-provider">[[+method_options]]</select></div>
<div class="m2af-row"><button type="button" id="m2af-setup">[[+setup_label]]</button><button type="button" id="m2af-enable" [[+enable_disabled]]>[[+enable_label]]</button></div>
<div id="m2af-message" class="m2af-message" role="status" aria-live="polite"></div>
<div id="m2af-setup-box" class="m2af-setup"></div>
<div class="m2af-setup" id="m2af-disable-box" style="display:block;margin-top:24px"><strong>[[+disable_title]]</strong><p class="m2af-muted m2af-small">[[+disable_hint]]</p><label for="m2af-password">[[+password_label]]</label><input id="m2af-password" type="password" autocomplete="current-password" class="wide"><div class="m2af-row"><button type="button" class="danger" id="m2af-disable">[[+disable_label]]</button></div></div>
</div>
