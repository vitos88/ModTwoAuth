<div class="m2af-sessions-card" id="m2as-sessions" data-api="[[+api]]" data-csrf="[[+csrf]]" data-show-current="[[+show_current]]">
<style>
.m2as-sessions-card{max-width:760px;padding:24px;border:1px solid #d9dee5;border-radius:12px;background:#fff;color:#20252b;font:16px/1.5 system-ui,-apple-system,sans-serif}.m2as-sessions-card h2{margin:0 0 8px}.m2as-muted{color:#626d78}.m2as-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:16px 0}.m2as-sessions-card button{font:inherit;padding:10px 12px;border:1px solid #b8c1cb;border-radius:7px;cursor:pointer;background:#1459a6;color:#fff}.m2as-sessions-card button.danger{background:#a52828;border-color:#a52828}.m2as-session{border:1px solid #d9dee5;border-radius:8px;padding:12px;margin:10px 0;overflow-wrap:anywhere}.m2as-session strong{display:block;margin-bottom:4px}.m2as-session-meta{font-size:.9rem;color:#626d78;margin:3px 0}.m2as-session-current{display:inline-block;background:#e9f8ee;color:#176b35;border-radius:4px;padding:2px 7px;font-size:.8rem}
</style>
<h2>[[+title]]</h2>
<p class="m2as-muted">[[+intro]]</p>
<div class="m2as-row"><button type="button" id="m2as-refresh">[[+refresh_label]]</button></div>
<div id="m2as-list" aria-live="polite">[[+loading_label]]</div>
</div>
